      "added_lines": [
        {
          "a_line": 110,
          "content": "\t * Finds all page revision dump files, online or locally, that are relevant"
        },
        {
          "a_line": 111,
          "content": "\t * to obtain the most current state of the data. Revision dump files are"
        },
        {
          "a_line": 112,
          "content": "\t * dumps that contain page revisions in MediaWiki's XML format."
        },
        {
          "a_line": 113,
          "content": "\t * <p>"
        },
        {
          "a_line": 114,
          "content": "\t * If the parameter <b>preferCurrent</b> is true, then dumps that contain"
        },
        {
          "a_line": 115,
          "content": "\t * only the current versions of all files will be preferred if available"
        },
        {
          "a_line": 116,
          "content": "\t * anywhere, even over previously downloaded dump files that contain all"
        },
        {
          "a_line": 117,
          "content": "\t * versions. However, dump files may still contain non-current revisions,"
        },
        {
          "a_line": 118,
          "content": "\t * and when processing multiple dumps there might even be overlaps (one"
        },
        {
          "a_line": 119,
          "content": "\t * revision occurring in multiple dumps)."
        },
        {
          "a_line": 120,
          "content": "\t * <p>"
        },
        {
          "a_line": 121,
          "content": "\t * The result is ordered with the most recent dump first. If a dump file A"
        },
        {
          "a_line": 122,
          "content": "\t * contains revisions of a page P, and Rmax is the maximal revision of P in"
        },
        {
          "a_line": 123,
          "content": "\t * A, then every dump file that comes after A should contain only revisions"
        },
        {
          "a_line": 124,
          "content": "\t * of P that are smaller than or equal to Rmax. In other words, the maximal"
        },
        {
          "a_line": 125,
          "content": "\t * revision found in the first file that contains P at all should also be"
        },
        {
          "a_line": 126,
          "content": "\t * the maximal revision overall."
        },
        {
          "a_line": 130,
          "content": "\t * @return an ordered list of all dump files that match the given criteria"
        },
        {
          "a_line": 132,
          "content": "\tpublic List<MwDumpFile> findAllRelevantRevisionDumps(boolean preferCurrent) {"
        },
        {
          "a_line": 133,
          "content": "\t\tMwDumpFile mainDump;"
        },
        {
          "a_line": 134,
          "content": "\t\tif (preferCurrent) {"
        },
        {
          "a_line": 135,
          "content": "\t\t\tmainDump = findMostRecentDump(DumpContentType.CURRENT);"
        },
        {
          "a_line": 136,
          "content": "\t\t} else {"
        },
        {
          "a_line": 137,
          "content": "\t\t\tmainDump = findMostRecentDump(DumpContentType.FULL);"
        },
        {
          "a_line": 138,
          "content": "\t\t}"
        },
        {
          "a_line": 139,
          "content": "\t\tif (mainDump == null) {"
        },
        {
          "a_line": 140,
          "content": "\t\t\treturn findAllDumps(DumpContentType.DAILY);"
        },
        {
          "a_line": 141,
          "content": "\t\t}"
        },
        {
          "a_line": 143,
          "content": "\t\tList<MwDumpFile> result = new ArrayList<MwDumpFile>();"
        },
        {
          "a_line": 144,
          "content": ""
        },
        {
          "a_line": 145,
          "content": "\t\tfor (MwDumpFile dumpFile : findAllDumps(DumpContentType.DAILY)) {"
        },
        {
          "a_line": 146,
          "content": "\t\t\tif (dumpFile.getDateStamp().compareTo(mainDump.getDateStamp()) > 0) {"
        },
        {
          "a_line": 147,
          "content": "\t\t\t\tresult.add(dumpFile);"
        },
        {
          "a_line": 150,
          "content": ""
        },
        {
          "a_line": 151,
          "content": "\t\tresult.add(mainDump);"
        },
        {
          "a_line": 152,
          "content": ""
        },
        {
          "a_line": 153,
          "content": "\t\tif (logger.isInfoEnabled()) {"
        },
        {
          "a_line": 154,
          "content": "\t\t\tStringBuilder logMessage = new StringBuilder();"
        },
        {
          "a_line": 155,
          "content": "\t\t\tlogMessage.append(\"Found \" + result.size()"
        },
        {
          "a_line": 156,
          "content": "\t\t\t\t\t+ \" relevant dumps to process:\");"
        },
        {
          "a_line": 157,
          "content": "\t\t\tfor (MwDumpFile dumpFile : result) {"
        },
        {
          "a_line": 158,
          "content": "\t\t\t\tlogMessage.append(\"\\n * \").append(dumpFile.toString());"
        },
        {
          "a_line": 159,
          "content": "\t\t\t}"
        },
        {
          "a_line": 160,
          "content": "\t\t\tlogger.info(logMessage.toString());"
        },
        {
          "a_line": 161,
          "content": "\t\t}"
        },
        {
          "a_line": 162,
          "content": ""
        },
        {
          "a_line": 163,
          "content": "\t\treturn result;"
        }
      ]
    },
