          "b_line": 218,
          "a_line": 219,
          "content": "\t * statements."
        },
        {
          "b_line": 219,
          "a_line": 220,
          "content": "\t * <p>"
        },
        {
          "b_line": 220,
          "a_line": 221,
          "content": "\t * See the <a href="
        },
        {
          "b_line": 221,
          "a_line": 222,
          "content": "\t * \"https://www.wikidata.org/w/api.php?action=help&modules=wbeditentity\""
        },
        {
          "b_line": 222,
          "a_line": 223,
          "content": "\t * >online API documentation</a> for further information."
        },
        {
          "b_line": 223,
          "a_line": 224,
          "content": "\t * <p>"
        },
        {
          "b_line": 224,
          "a_line": 225,
          "content": "\t * TODO: There is currently no way to delete the label, description, or"
        },
        {
          "b_line": 225,
          "a_line": 226,
          "content": "\t * aliases for a particular language without clearing all data. Empty"
        },
        {
          "b_line": 226,
          "a_line": 227,
          "content": "\t * strings are not accepted. One might achieve this by adapting the JSON"
        },
        {
          "b_line": 227,
          "a_line": 228,
          "content": "\t * serialization to produce null values for such strings, and for alias"
        },
        {
          "b_line": 228,
          "a_line": 229,
          "content": "\t * lists that contain only such strings."
        },
        {
          "b_line": 229,
          "a_line": 230,
          "content": "\t *"
        },
        {
          "b_line": 230,
          "a_line": 231,
          "content": "\t * @param id"
        },
        {
          "b_line": 231,
          "a_line": 232,
          "content": "\t *            the id of the entity to be edited; if used, the site and title"
        },
        {
          "b_line": 232,
          "a_line": 233,
          "content": "\t *            parameters must be null"
        },
        {
          "b_line": 233,
          "a_line": 234,
          "content": "\t * @param site"
        },
        {
          "b_line": 234,
          "a_line": 235,
          "content": "\t *            when selecting an entity by title, the site key for the title,"
        },
        {
          "b_line": 235,
          "a_line": 236,
          "content": "\t *            e.g., \"enwiki\"; if used, title must also be given but id must"
        },
        {
          "b_line": 236,
          "a_line": 237,
          "content": "\t *            be null"
        },
        {
          "b_line": 237,
          "a_line": 238,
          "content": "\t * @param title"
        },
        {
          "b_line": 238,
          "a_line": 239,
          "content": "\t *            string used to select an entity by title; if used, site must"
        },
        {
          "b_line": 239,
          "a_line": 240,
          "content": "\t *            also be given but id must be null"
        },
        {
          "b_line": 240,
          "a_line": 241,
          "content": "\t * @param newEntity"
        },
        {
          "b_line": 241,
          "a_line": 242,
          "content": "\t *            used for creating a new entity of a given type; the value"
        },
        {
          "b_line": 242,
          "a_line": 243,
          "content": "\t *            indicates the intended entity type; possible values include"
        },
        {
          "b_line": 243,
          "a_line": 244,
          "content": "\t *            \"item\" and \"property\"; if used, the parameters id, site, and"
        },
        {
          "b_line": 244,
          "a_line": 245,
          "content": "\t *            title must be null"
        },
        {
          "b_line": 245,
          "a_line": 246,
          "content": "\t * @param data"
        },
        {
          "b_line": 246,
          "a_line": 247,
          "content": "\t *            JSON representation of the data that is to be written; this is"
        },
        {
          "b_line": 247,
          "a_line": 248,
          "content": "\t *            a mandatory parameter"
        },
        {
          "b_line": 248,
          "a_line": 249,
          "content": "\t * @param clear"
        },
        {
          "b_line": 249,
          "a_line": 250,
          "content": "\t *            if true, existing data will be cleared (deleted) before"
        },
        {
          "b_line": 250,
          "a_line": 251,
          "content": "\t *            writing the new data"
        },
        {
          "b_line": 251,
          "a_line": 252,
          "content": "\t * @param bot"
        },
        {
          "b_line": 252,
          "a_line": 253,
          "content": "\t *            if true, edits will be flagged as \"bot edits\" provided that"
        },
        {
          "b_line": 253,
          "a_line": 254,
          "content": "\t *            the logged in user is in the bot group; for regular users, the"
        },
        {
          "b_line": 254,
          "a_line": 255,
          "content": "\t *            flag will just be ignored"
        },
        {
          "b_line": 255,
          "a_line": 256,
          "content": "\t * @param baserevid"
        },
        {
          "b_line": 256,
          "a_line": 257,
          "content": "\t *            the revision of the data that the edit refers to or 0 if this"
        },
        {
          "b_line": 257,
          "a_line": 258,
          "content": "\t *            should not be submitted; when used, the site will ensure that"
        },
        {
          "b_line": 258,
          "a_line": 259,
          "content": "\t *            no edit has happened since this revision to detect edit"
        },
        {
          "b_line": 259,
          "a_line": 260,
          "content": "\t *            conflicts; it is recommended to use this whenever in all"
        },
        {
          "b_line": 260,
          "a_line": 261,
          "content": "\t *            operations where the outcome depends on the state of the"
        },
        {
          "b_line": 261,
          "a_line": 262,
          "content": "\t *            online data"
        },
        {
          "b_line": 262,
          "a_line": 263,
          "content": "\t * @param summary"
        },
        {
          "b_line": 263,
          "a_line": 264,
          "content": "\t *            summary for the edit; will be prepended by an automatically"
        },
        {
          "b_line": 264,
          "a_line": 265,
          "content": "\t *            generated comment; the length limit of the autocomment"
        },
        {
          "b_line": 265,
          "a_line": 266,
          "content": "\t *            together with the summary is 260 characters: everything above"
        },
        {
          "b_line": 266,
          "a_line": 267,
          "content": "\t *            that limit will be cut off"
        },
        {
          "b_line": 267,
          "a_line": 270,
          "content": "\t * @return the JSON response as returned by the API"
        },
        {
          "b_line": 268,
          "a_line": 271,
          "content": "\t * @throws IOException"
        },
        {
          "b_line": 269,
          "a_line": 272,
          "content": "\t *             if there was an IO problem. such as missing network"
        },
        {
          "b_line": 270,
          "a_line": 273,
          "content": "\t *             connection"
        },
        {
          "b_line": 271,
          "a_line": 274,
          "content": "\t * @throws MediaWikiApiErrorException"
        },
        {
          "b_line": 272,
          "a_line": 275,
          "content": "\t *             if the API returns an error"
        },
        {
          "b_line": 273,
          "a_line": 276,
          "content": "\t */"
        },
        {
          "b_line": 274,
          "a_line": 277,
          "content": "\tpublic EntityDocument wbEditEntity(String id, String site, String title,"
        },
