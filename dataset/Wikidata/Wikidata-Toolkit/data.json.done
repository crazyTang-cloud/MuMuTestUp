      "line_mapping": [
        {
          "b_line": 106,
          "a_line": 104,
          "content": "/**"
        },
        {
          "b_line": 107,
          "a_line": 105,
          "content": "\t * Creates a map of identifiers or page titles to documents retrieved via"
        },
        {
          "b_line": 108,
          "a_line": 106,
          "content": "\t * the API. All parameters that accept lists expect the pipe character | to"
        },
        {
          "b_line": 109,
          "a_line": 107,
          "content": "\t * be used as a separator, as created by"
        },
        {
          "b_line": 110,
          "a_line": 108,
          "content": "\t * {@link ApiConnection#implodeObjects(Iterable)}. There is a limit on how"
        },
        {
          "b_line": 111,
          "a_line": 109,
          "content": "\t * many entities can be retrieved in one request, usually 50 by default and"
        },
        {
          "b_line": 112,
          "a_line": 110,
          "content": "\t * 500 for bots. This limit may also apply to the number of language codes"
        },
        {
          "b_line": 113,
          "a_line": 111,
          "content": "\t * and sites used for filtering."
        },
        {
          "b_line": 114,
          "a_line": 112,
          "content": "\t * <p>"
        },
        {
          "b_line": 115,
          "a_line": 113,
          "content": "\t * If errors occur (e.g., exceptions trying to access the Web API), then the"
        },
        {
          "b_line": 116,
          "a_line": 114,
          "content": "\t * errors will be logged and an empty collection will be returned."
        },
        {
          "b_line": 117,
          "a_line": 115,
          "content": "\t *"
        },
        {
          "b_line": 118,
          "a_line": 116,
          "content": "\t * @param ids"
        },
        {
          "b_line": 119,
          "a_line": 117,
          "content": "\t *            list of ids of entities for which data should be retrieved"
        },
        {
          "b_line": 120,
          "a_line": 118,
          "content": "\t * @param sites"
        },
        {
          "b_line": 121,
          "a_line": 119,
          "content": "\t *            site key (e.g. \"enwiki\"); used together with parameters"
        },
        {
          "b_line": 122,
          "a_line": 120,
          "content": "\t *            \"titles\"; the API supports the use of many site keys with a"
        },
        {
          "b_line": 123,
          "a_line": 121,
          "content": "\t *            single title, but this implementation does not support this"
        },
        {
          "b_line": 124,
          "a_line": 122,
          "content": "\t *            (the resulting map will use title strings for keys)"
        },
        {
          "b_line": 125,
          "a_line": 123,
          "content": "\t * @param titles"
        },
        {
          "b_line": 126,
          "a_line": 124,
          "content": "\t *            list of titles of the page corresponding to the requested"
        },
        {
          "b_line": 127,
          "a_line": 125,
          "content": "\t *            entities on the given site; use together with 'sites', but"
        },
        {
          "b_line": 128,
          "a_line": 126,
          "content": "\t *            only give one site for several titles or several sites for one"
        },
        {
          "b_line": 129,
          "a_line": 127,
          "content": "\t *            title"
        },
        {
          "b_line": 130,
          "a_line": 128,
          "content": "\t * @param props"
        },
        {
          "b_line": 131,
          "a_line": 129,
          "content": "\t *            list of strings that specifies what kind of data should be"
        },
        {
          "b_line": 132,
          "a_line": 130,
          "content": "\t *            retrieved for each entity; possible values include \"info\","
        },
        {
          "b_line": 133,
          "a_line": 131,
          "content": "\t *            \"sitelinks\", \"sitelinks/urls\", \"aliases\", \"labels\","
        },
        {
          "b_line": 134,
          "a_line": 132,
          "content": "\t *            \"descriptions\", \"claims\" (statements), \"datatype\"; additional"
        },
        {
          "b_line": 135,
          "a_line": 133,
          "content": "\t *            filters may apply; defaults to"
        },
        {
          "b_line": 136,
          "a_line": 134,
          "content": "\t *            \"info|sitelinks|aliases|labels|descriptions|claims|datatype\""
        },
        {
          "b_line": 137,
          "a_line": 135,
          "content": "\t * @param languages"
        },
        {
          "b_line": 138,
          "a_line": 136,
          "content": "\t *            list of language codes to return labels, aliases or"
        },
        {
          "b_line": 139,
          "a_line": 137,
          "content": "\t *            descriptions for; if omitted, data for all languages is"
        },
        {
          "b_line": 140,
          "a_line": 138,
          "content": "\t *            returned"
        },
        {
          "b_line": 141,
          "a_line": 139,
          "content": "\t * @param sitefilter"
        },
        {
          "b_line": 142,
          "a_line": 140,
          "content": "\t *            list of site keys to return sitelinks for; if omitted, data"
        },
        {
          "b_line": 143,
          "a_line": 141,
          "content": "\t *            for all languages is returned"
        },
        {
          "b_line": 144,
          "a_line": 142,
          "content": "\t *"
        },
        {
          "b_line": 145,
          "a_line": 143,
          "content": "\t * @return map of document identifiers or titles to documents retrieved via"
        },
        {
          "b_line": 146,
          "a_line": 144,
          "content": "\t *         the API URL"
        },
        {
          "b_line": 147,
          "a_line": 145,
          "content": "\t * @throws MediaWikiApiErrorException"
        },
        {
          "b_line": 148,
          "a_line": 146,
          "content": "\t *             if the API returns an error"
        },
        {
          "b_line": 151,
          "a_line": 147,
          "content": "\t * @throws IllegalArgumentException"
        },
        {
          "b_line": 152,
          "a_line": 148,
          "content": "\t *             if the given combination of parameters does not make sense"
        },
        {
          "b_line": 153,
          "a_line": 149,
          "content": "\t */"
        },
