        },
        {
          "b_line": 225,
          "a_line": 224,
          "content": "\t * TODO: There is currently no way to delete the label, description, or"
        },
        {
          "b_line": 226,
          "a_line": 225,
          "content": "\t * aliases for a particular language without clearing all data. Empty"
        },
        {
          "b_line": 227,
          "a_line": 226,
          "content": "\t * strings are not accepted. One might achieve this by adapting the JSON"
        },
        {
          "b_line": 228,
          "a_line": 227,
          "content": "\t * serialization to produce null values for such strings, and for alias"
        },
        {
          "b_line": 229,
          "a_line": 228,
          "content": "\t * lists that contain only such strings."
        },
        {
          "b_line": 230,
          "a_line": 229,
          "content": "\t *"
        },
        {
          "b_line": 231,
          "a_line": 230,
          "content": "\t * @param id"
        },
        {
          "b_line": 232,
          "a_line": 231,
          "content": "\t *            the id of the entity to be edited; if used, the site and title"
        },
        {
          "b_line": 233,
          "a_line": 232,
          "content": "\t *            parameters must be null"
        },
        {
          "b_line": 234,
          "a_line": 233,
          "content": "\t * @param site"
        },
        {
          "b_line": 235,
          "a_line": 234,
          "content": "\t *            when selecting an entity by title, the site key for the title,"
        },
        {
          "b_line": 236,
          "a_line": 235,
          "content": "\t *            e.g., \"enwiki\"; if used, title must also be given but id must"
        },
        {
          "b_line": 237,
          "a_line": 236,
          "content": "\t *            be null"
        },
        {
          "b_line": 238,
          "a_line": 237,
          "content": "\t * @param title"
        },
        {
          "b_line": 239,
          "a_line": 238,
          "content": "\t *            string used to select an entity by title; if used, site must"
        },
        {
          "b_line": 240,
          "a_line": 239,
          "content": "\t *            also be given but id must be null"
        },
        {
          "b_line": 241,
          "a_line": 240,
          "content": "\t * @param newEntity"
        },
        {
          "b_line": 242,
          "a_line": 241,
          "content": "\t *            used for creating a new entity of a given type; the value"
        },
        {
          "b_line": 243,
          "a_line": 242,
          "content": "\t *            indicates the intended entity type; possible values include"
        },
        {
          "b_line": 244,
          "a_line": 243,
          "content": "\t *            \"item\" and \"property\"; if used, the parameters id, site, and"
        },
        {
          "b_line": 245,
          "a_line": 244,
          "content": "\t *            title must be null"
        },
        {
          "b_line": 246,
          "a_line": 245,
          "content": "\t * @param data"
        },
        {
          "b_line": 247,
          "a_line": 246,
          "content": "\t *            JSON representation of the data that is to be written; this is"
        },
        {
          "b_line": 248,
          "a_line": 247,
          "content": "\t *            a mandatory parameter"
        },
        {
          "b_line": 249,
          "a_line": 248,
          "content": "\t * @param clear"
        },
        {
          "b_line": 250,
          "a_line": 249,
          "content": "\t *            if true, existing data will be cleared (deleted) before"
        },
        {
          "b_line": 251,
          "a_line": 250,
          "content": "\t *            writing the new data"
        },
        {
          "b_line": 252,
          "a_line": 251,
          "content": "\t * @param bot"
        },
        {
          "b_line": 253,
          "a_line": 252,
          "content": "\t *            if true, edits will be flagged as \"bot edits\" provided that"
        },
        {
          "b_line": 254,
          "a_line": 253,
          "content": "\t *            the logged in user is in the bot group; for regular users, the"
        },
        {
          "b_line": 255,
          "a_line": 254,
          "content": "\t *            flag will just be ignored"
        },
        {
          "b_line": 256,
          "a_line": 255,
          "content": "\t * @param baserevid"
        },
        {
          "b_line": 257,
          "a_line": 256,
          "content": "\t *            the revision of the data that the edit refers to or 0 if this"
        },
        {
          "b_line": 258,
          "a_line": 257,
          "content": "\t *            should not be submitted; when used, the site will ensure that"
        },
        {
          "b_line": 259,
          "a_line": 258,
          "content": "\t *            no edit has happened since this revision to detect edit"
        },
        {
          "b_line": 260,
          "a_line": 259,
