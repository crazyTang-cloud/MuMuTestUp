  {
    "name": "org.wikidata.wdtk.wikibaseapi.WbEditingActionTest.testNewAndSite()",
    "bSource": {
      "startLine": 172,
      "code": "@Test(expected = IllegalArgumentException.class)\n\tpublic void testNewAndSite() throws IOException, MediaWikiApiErrorException {\n\t\tWbEditingAction weea = new WbEditingAction(\n\t\t\t\tnew MockBasicApiConnection(), Datamodel.SITE_WIKIDATA);\n\t\tweea.wbEditEntity(null, \"enwiki\", null, \"item\", \"{}\", false, false, 0,\n\t\t\t\tnull);\n\t}"
    },
